<Window x:Class="GvrTools.Tools.BatchExport.Views.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GvrTools.Tools.BatchExport.Views"
        Title="GVR Tools - Trazado masivo" Height="900" Width="1060"
        MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Trazar presentaciones" Style="{StaticResource Gvr.Text.Title}"/>
            <TextBlock Text="{Binding DocumentTitle, StringFormat=' · {0}'}" Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding CanEditOptions}"
                    SelectedIndex="{Binding Wizard.SelectedIndex, Mode=TwoWay}">

            <!-- ============================================================ Presentaciones -->
            <TabItem Header="1. Presentaciones">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Ninguna" Command="{Binding SelectNoneCommand}" Margin="6,0,0,0" Padding="10,2"/>
                        <Button DockPanel.Dock="Right" Content="Todas" Command="{Binding SelectAllCommand}" Padding="10,2"/>
                    </DockPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding Layouts}" BorderBrush="{StaticResource Gvr.Brush.Line}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="32">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Presentación" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Configuración de página" Width="150" DisplayMemberBinding="{Binding PageSetupName}"/>
                                <GridViewColumn Header="Dispositivo" Width="170" DisplayMemberBinding="{Binding PlotDeviceLabel}"/>
                                <GridViewColumn Header="Papel" Width="200" DisplayMemberBinding="{Binding PaperLabel}"/>
                                <GridViewColumn Header="Tabla de estilos" Width="120" DisplayMemberBinding="{Binding PlotStyleTableLabel}"/>
                                <GridViewColumn Header="Último trazado" Width="110" DisplayMemberBinding="{Binding LastExportedLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ============================================================ Trazado -->
            <TabItem Header="2. Trazado" IsEnabled="{Binding Wizard.CanOpenStep1}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <views:PlotConfigurationView DataContext="{Binding Plot}"/>

                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Presentación de referencia:" Style="{StaticResource Gvr.Text.Label}"/>
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Layouts}" SelectedItem="{Binding PreviewLayout}"
                                      DisplayMemberPath="Name" MinWidth="220"
                                      ToolTip="Presentación que se muestra en la vista preliminar y donde se designa la ventana común."/>
                            <Button DockPanel.Dock="Left" Content="Vista preliminar..." Command="{Binding PreviewCommand}" Margin="8,0,0,0" Padding="10,2"
                                    ToolTip="Muestra la vista preliminar de AutoCAD con esta configuración. Cierra la vista (Esc) para volver."/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Salida -->
            <TabItem Header="3. Salida" IsEnabled="{Binding Wizard.CanOpenStep2}">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding Plot.OutputSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,12"/>

                    <TextBlock Text="Carpeta de destino" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                    <DockPanel Margin="0,0,0,4" IsEnabled="{Binding Plot.WritesFiles}">
                        <Button DockPanel.Dock="Right" Content="Examinar..." Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Padding="10,2"/>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding DestinationSummary}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Nomenclatura de archivos" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                    <StackPanel IsEnabled="{Binding Plot.WritesFiles}">
                        <TextBox Text="{Binding NamingPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NamingHelpText}" Style="{StaticResource Gvr.Text.Subtle}" FontSize="11"/>
                        <TextBlock Text="{Binding NamingPreview, StringFormat='Ejemplo: {0}'}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,14"/>
                    </StackPanel>

                    <TextBlock Text="Opciones" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                    <CheckBox Content="Combinar todo en un solo archivo" IsChecked="{Binding Plot.CombineIntoSingleFile}"
                              IsEnabled="{Binding Plot.CanCombine}" Margin="0,0,0,2"
                              ToolTip="Un único PDF/DWF de varias hojas, todas con el mismo tamaño de papel."/>
                    <TextBlock Text="{Binding Plot.CombineBlocker}" Style="{StaticResource Gvr.Text.Subtle}" Margin="20,0,0,8"/>
                    <CheckBox Content="Abrir la carpeta al terminar" IsChecked="{Binding OpenFolderWhenDone}"
                              IsEnabled="{Binding Plot.WritesFiles}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Gvr.Text.Subtle}"/>
            <ListView ItemsSource="{Binding Results}" MaxHeight="120"
                      Visibility="{Binding ShowResults, Converter={StaticResource Gvr.BoolToVisibility}}"
                      Margin="0,6,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header=" " Width="24" DisplayMemberBinding="{Binding StatusIcon}"/>
                        <GridViewColumn Header="Presentación" Width="240" DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="Detalle" Width="560" DisplayMemberBinding="{Binding Detail}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <DockPanel Grid.Row="3" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Abrir carpeta" Command="{Binding OpenFolderCommand}" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="Trazar" Command="{Binding ExportCommand}" Margin="8,0,0,0" Padding="20,4" FontWeight="SemiBold"
                    ToolTip="Se activa al llegar al paso 3 (Salida), con presentaciones seleccionadas y una configuración válida."/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="10,4"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanEditOptions}">
                <Button Content="&lt; Atrás" Command="{Binding Wizard.BackCommand}" Padding="10,4"/>
                <Button Content="Siguiente &gt;" Command="{Binding Wizard.NextCommand}" Margin="6,0,0,0" Padding="10,4"/>
            </StackPanel>
            <TextBlock Text="{Binding Wizard.StepHint}" Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="12,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
