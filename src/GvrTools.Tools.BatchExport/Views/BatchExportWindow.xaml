<Window x:Class="GvrTools.Tools.BatchExport.Views.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GVR Tools - Exportación masiva" Height="760" Width="720"
        MinHeight="640" MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/GvrTools.UI;component/Theme/GvrTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="{StaticResource Gvr.Padding.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Exportar presentaciones a PDF" Style="{StaticResource Gvr.Text.Title}"/>
            <TextBlock Text="{Binding DocumentTitle, StringFormat=' · {0}'}" Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
        </StackPanel>

        <!-- Destino y nomenclatura -->
        <Border Grid.Row="1" Background="{StaticResource Gvr.Brush.Surface}" Padding="{StaticResource Gvr.Padding.Card}" Margin="0,0,0,10" IsEnabled="{Binding CanEditOptions}">
            <StackPanel>
                <TextBlock Text="Carpeta de destino" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Examinar..." Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="{Binding DestinationFolder, StringFormat='Se creará: {0}'}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,10"/>

                <TextBlock Text="Nomenclatura de archivos" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                <TextBox Text="{Binding NamingPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding NamingHelpText}" Style="{StaticResource Gvr.Text.Subtle}" FontSize="11"/>
                <TextBlock Text="{Binding NamingPreview, StringFormat='Ejemplo: {0}'}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Grilla de presentaciones -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Gvr.Brush.Line}" BorderThickness="1" Margin="0,0,0,10" MinHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Gvr.Text.Subtle}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Ninguna" Command="{Binding SelectNoneCommand}" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Todas" Command="{Binding SelectAllCommand}"/>
                </DockPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding Layouts}" IsEnabled="{Binding CanEditOptions}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="32">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Presentación" Width="320" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Configuración de página" Width="150" DisplayMemberBinding="{Binding PageSetupName}"/>
                            <GridViewColumn Header="Tabla de estilos" Width="160" DisplayMemberBinding="{Binding PlotStyleTableLabel}"/>
                            <GridViewColumn Header="Última exportación" Width="130" DisplayMemberBinding="{Binding LastExportedLabel}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Opciones PDF -->
        <Border Grid.Row="3" Background="{StaticResource Gvr.Brush.Surface}" Padding="{StaticResource Gvr.Padding.Card}" Margin="0,0,0,10" IsEnabled="{Binding CanEditOptions}">
            <StackPanel>
                <TextBlock Text="Opciones de PDF" Style="{StaticResource Gvr.Text.SectionHeader}"/>
                <TextBlock Text="{Binding StrategyDescription}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PlotPresetHelpText}" Style="{StaticResource Gvr.Text.Subtle}" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="11"
                           ToolTip="{Binding PlotPresetHelpText}"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Dispositivo de trazado (.pc3):" Style="{StaticResource Gvr.Text.Label}"
                               ToolTip="{Binding PlotDeviceHelpText}"/>
                    <ComboBox ItemsSource="{Binding PlotDevices}" SelectedItem="{Binding PlotDeviceName}"
                              ToolTip="{Binding PlotDeviceHelpText}"/>
                </DockPanel>
                <TextBlock Text="{Binding MissingPlotDeviceWarning}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Foreground="{StaticResource Gvr.Brush.Danger}"
                           Visibility="{Binding HasMissingPlotDevice, Converter={StaticResource Gvr.BoolToVisibility}}"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Tabla de estilos (plumas CTB/STB):" Style="{StaticResource Gvr.Text.Label}"
                               ToolTip="{Binding PlotStyleHelpText}"/>
                    <Button DockPanel.Dock="Right" Content="Examinar..." Command="{Binding ImportPlotStyleCommand}"
                            Margin="8,0,0,0"
                            ToolTip="Selecciona un .ctb/.stb del proyecto; se instalará en AutoCAD y quedará seleccionado."/>
                    <ComboBox ItemsSource="{Binding PlotStyleTables}" SelectedItem="{Binding SelectedPlotStyleTable}"
                              ToolTip="{Binding PlotStyleHelpText}"/>
                </DockPanel>
                <TextBlock Text="{Binding MissingPlotStyleWarning}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Foreground="{StaticResource Gvr.Brush.Danger}"
                           Visibility="{Binding HasMissingPlotStyle, Converter={StaticResource Gvr.BoolToVisibility}}"/>

                <CheckBox Content="Trazar transparencias" IsChecked="{Binding PlotTransparency}" Margin="0,0,0,6"
                          ToolTip="Equivale a la casilla Plot transparency del cuadro Imprimir de AutoCAD."/>
                <CheckBox Content="Combinar todo en un solo PDF" IsChecked="{Binding CombineIntoSinglePdf}" Margin="0,0,0,6"/>
                <CheckBox Content="Abrir la carpeta al terminar" IsChecked="{Binding OpenFolderWhenDone}"/>
            </StackPanel>
        </Border>

        <!-- Progreso / resultados -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Gvr.Text.Subtle}"/>
            <ListView ItemsSource="{Binding Results}" MaxHeight="140"
                      Visibility="{Binding ShowResults, Converter={StaticResource Gvr.BoolToVisibility}}"
                      Margin="0,6,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header=" " Width="24" DisplayMemberBinding="{Binding StatusIcon}"/>
                        <GridViewColumn Header="Presentación" Width="240" DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="Detalle" Width="360" DisplayMemberBinding="{Binding Detail}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Abrir carpeta" Command="{Binding OpenFolderCommand}"/>
            <Button DockPanel.Dock="Right" Content="Exportar" Command="{Binding ExportCommand}" Margin="8,0,0,0" Padding="16,4" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}"/>
        </DockPanel>
    </Grid>
</Window>
